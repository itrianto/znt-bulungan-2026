rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Polygon Master Zona SIPENTA untuk Dashboard Kendali ZNT
    match /polygons/{allPaths=**} {
      // Publik dapat mengunduh master polygon
      allow read: if true;
      // Hanya admin terdaftar di Firestore yang boleh mengunggah polygon (maks 50MB)
      allow write: if request.auth != null 
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
        && request.resource.size < 50 * 1024 * 1024;
    }
  }
}
